# Hypa API settings for local development.
# Copy this file to .env (git-ignored) and fill in your key:  cp .env.example .env
# Never commit .env, and never put the key in Assets/, StreamingAssets, Resources or the APK.
# On Quest, push it to the app's private folder instead:
#   adb push .env /sdcard/Android/data/ai.hypa.lens/files/.env

HYPA_API_KEY=
HYPA_BASE_URL=https://api.hypaintelligence.com
